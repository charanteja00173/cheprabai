REACT_APP_SOCKET_ENDPOINT=https://your-production-backend.onrender.com
REACT_APP_GIPHY_API_KEY=your_giphy_api_key
REACT_APP_SECURITY_CODES=@Anonymous@,Letsdoit,letsStart,3Idiots
REACT_APP_NOTIFICATION_SOUND=/assets/iphone-sms.mp3

# Production WebRTC TURN settings (for routing video/audio calls behind firewalls)
REACT_APP_TURN_URL=turn:your-turn-domain.com:3478
REACT_APP_TURN_USERNAME=your_turn_username
REACT_APP_TURN_PASSWORD=your_turn_password
